# Database Configuration
DB_PASSWORD=your_database_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_key

# Site Configuration
API_URL=https://api.yourdomain.com/api/v1

# MCP Authentication (optional, default: static)
MCP_AUTH_MODE=static
MCP_OAUTH_RESOURCE_URI=
MCP_OAUTH_ISSUER=
MCP_OAUTH_JWKS_URL=
MCP_OAUTH_AUDIENCE=
MCP_OAUTH_EMBEDDED_SERVER=false
MCP_OAUTH_SIGNING_KEY_FILE=
MCP_OAUTH_CHALLENGE_SCOPES=
