# 服务器配置
SERVER_PORT=8080
SERVER_ALLOW_ORIGINS=*
API_URL=https://api.yourdomain.com/api/v1

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_database_password

# JWT 配置
JWT_SECRET=your_jwt_secret_key

# MCP 认证（可选，默认 static）
MCP_AUTH_MODE=static
MCP_OAUTH_RESOURCE_URI=
MCP_OAUTH_ISSUER=
MCP_OAUTH_JWKS_URL=
MCP_OAUTH_AUDIENCE=
MCP_OAUTH_EMBEDDED_SERVER=false
MCP_OAUTH_SIGNING_KEY_FILE=
MCP_OAUTH_CHALLENGE_SCOPES=
